{
  "name": "furusato-kangen-checker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ふるさと納税の寄附額と市場価格から還元率・単価を計算する判定ツール",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "vendor": "node scripts/vendor-ocr.mjs",
    "build": "node scripts/build-www.mjs",
    "sync": "npm run build && npx cap sync",
    "serve": "npx http-server . -p 8080 -c-1",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/jpn": "^1.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
